{
  "name": "avk-studio",
  "productName": "AVK Sinema",
  "version": "0.1.8",
  "description": "AVK Sinema - AI Video Kulübü Türkçe yapay zeka video stüdyosu",
  "main": "main.js",
  "author": "AI Video Kulübü",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "club.aivideokulubu.studio",
    "productName": "AVK Sinema",
    "icon": "build/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "lib/**/*",
      "assets/**/*",
      "config.json",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "tnrklcan",
        "repo": "avk-studio"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg"
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.video",
      "identity": null,
      "artifactName": "AVK-Sinema-Mac-${arch}.${ext}",
      "extraResources": [
        {
          "from": "browsers",
          "to": "browsers"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "AVK Sinema",
      "artifactName": "AVK-Sinema-Windows.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "^1.65.0"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  }
}
