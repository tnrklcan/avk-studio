{
  "name": "avk-studio",
  "productName": "AVK Studio",
  "version": "0.1.1",
  "description": "AI Video Kulübü - Türkçe yapay zeka video stüdyosu",
  "main": "main.js",
  "author": "AI Video Kulübü",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "club.aivideokulubu.studio",
    "productName": "AVK Studio",
    "icon": "build/icon.png",
    "files": ["main.js","preload.js","src/**/*","lib/**/*","assets/**/*","package.json"],
    "asarUnpack": ["node_modules/ffmpeg-static/**"],
    "publish": [{ "provider": "github", "owner": "tnrklcan", "repo": "avk-studio" }],
    "mac": { "target": [{"target":"dmg","arch":["arm64","x64"]},{"target":"zip","arch":["arm64","x64"]}], "category": "public.app-category.video", "identity": null },
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "^1.65.0"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  }
}
